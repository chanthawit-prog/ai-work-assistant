#!/usr/bin/env python3
"""Stand-in for the `claude` CLI, for trying the dashboard and running tests without using Claude.

It understands just enough of `claude -p --output-format stream-json`: it reads the task from stdin,
emits realistic stream-json events slowly (so you can watch the timeline), and writes sample files
for every "- output/..." line in the task. Use it with CLAUDE_BIN=/opt/app/scripts/fake-claude.

Environment knobs (for tests):
  FAKE_CLAUDE_DELAY=0.6        seconds between events
  FAKE_CLAUDE_FAIL=1           finish with an error result
  FAKE_CLAUDE_FAIL=auth        fail the way Claude Code does when nobody is logged in
  FAKE_CLAUDE_RATE_LIMIT=1     report a rejected subscription quota, then fail
  FAKE_CLAUDE_SKIP_OUTPUTS=1   succeed without writing the output files
  FAKE_CLAUDE_CRASH=kill       die mid-run by SIGKILL, as the kernel's OOM killer would do it
  FAKE_CLAUDE_CRASH=oom        print an out-of-memory error on stderr and exit
  FAKE_CLAUDE_DUMP_ENV=<file>  write the environment it was started with to <file> (JSON)
  FAKE_CLAUDE_ALLOC_MB=400     hold this much RAM while working (to try the container's memory limit)
"""
import json
import os
import re
import signal
import sys
import time
import uuid
from datetime import date, timedelta
from pathlib import Path


def emit(event: dict) -> None:
    sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def stream_text(text: str, base: dict, delay: float) -> None:
    """Mimic --include-partial-messages: token deltas, then the complete assistant message."""
    emit({"type": "stream_event", "parent_tool_use_id": None, "event": {"type": "message_start"}, **base})
    for word in re.findall(r"\S+\s*", text):
        emit({"type": "stream_event", "parent_tool_use_id": None,
              "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": word}}, **base})
        time.sleep(delay / 6)
    emit({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [{"type": "text", "text": text}]}, **base})


def arg_value(argv: list, name: str):
    return argv[argv.index(name) + 1] if name in argv and argv.index(name) + 1 < len(argv) else None


def sample_content(rel: str, title: str) -> str:
    if rel.endswith("action_items.json"):
        today = date.today()
        return json.dumps([
            {"task": "ส่งแบบ single line diagram ฉบับแก้ไขให้ลูกค้า", "owner": "สมชาย",
             "due": (today + timedelta(days=3)).isoformat(), "priority": "high", "notes": "ตัวอย่างจาก demo"},
            {"task": "ขอใบเสนอราคา cable tray จาก supplier 2 ราย", "owner": "วิภา",
             "due": (today + timedelta(days=7)).isoformat(), "priority": "medium", "notes": ""},
        ], ensure_ascii=False, indent=2)
    if rel.endswith(".json"):
        return "{}"
    if rel.endswith(".py"):
        return "print('demo')\n"
    return (f"# {title}\n\n> ไฟล์นี้สร้างโดย fake-claude (โหมดสาธิต) ยังไม่ได้ใช้ Claude จริง\n\n"
            "## สรุปสั้น\n- ระบบรับงาน ส่งให้ตัวประมวลผล และแสดงความคืบหน้าได้ถูกต้อง\n\n"
            "## ตารางตัวอย่าง\n| รายการ | สถานะ |\n|---|---|\n| รับไฟล์ | ✅ |\n| เขียนผลลัพธ์ | ✅ |\n\n"
            "## สิ่งที่ต้องยืนยัน\n- เปลี่ยน `CLAUDE_BIN` กลับเป็น `claude` เพื่อใช้งานจริง\n")


def main(argv: list) -> int:
    if "--version" in argv or "-v" in argv:
        print("0.0.0 (fake-claude demo)")
        return 0
    if argv[:2] == ["auth", "status"]:
        print(json.dumps({"loggedIn": True, "authMethod": "demo", "apiProvider": "fake-claude"}))
        return 0
    if "-p" not in argv and "--print" not in argv:
        print("fake-claude: only -p (print mode) is supported", file=sys.stderr)
        return 2

    if os.environ.get("FAKE_CLAUDE_DUMP_ENV"):
        Path(os.environ["FAKE_CLAUDE_DUMP_ENV"]).write_text(json.dumps(dict(os.environ)), encoding="utf-8")
    prompt = sys.stdin.read()
    delay = float(os.environ.get("FAKE_CLAUDE_DELAY", "0.6"))
    session = arg_value(argv, "--resume") or str(uuid.uuid4())
    title_match = re.search(r"^ชื่องาน: (.+)$", prompt, re.M)
    title = title_match.group(1).strip() if title_match else "งานสาธิต"
    inputs = re.findall(r"^- (input/.+)$", prompt, re.M)
    outputs = list(dict.fromkeys(re.findall(r"^- (output/\S+)$", prompt, re.M)))
    # outputs the user edited on the dashboard: build on their version instead of starting over
    edited_block = re.search(r"^ผู้ใช้แก้ไฟล์ผลลัพธ์เหล่านี้ด้วยตนเอง[^\n]*\n((?:- output/\S+\n?)+)", prompt, re.M)
    edited = set(re.findall(r"^- (output/\S+)$", edited_block.group(1), re.M)) if edited_block else set()
    cwd = Path.cwd()
    base = {"session_id": session}
    follow_up = re.search(r"^ข้อความใหม่จากผู้ใช้:\n(.+?)(?:\n\n|$)", prompt, re.M | re.S)

    def pause() -> None:
        time.sleep(delay)

    emit({"type": "system", "subtype": "init", "model": "fake-model", "cwd": str(cwd), "tools": [],
          "permissionMode": arg_value(argv, "--permission-mode"), **base})
    pause()
    stream_text("รับงานแล้ว กำลังอ่านไฟล์ที่ได้รับ" if not follow_up
                else f"ได้รับข้อความแล้ว: “{follow_up.group(1).strip()[:80]}” กำลังปรับผลลัพธ์", base, delay)
    for i, rel in enumerate(inputs):
        pause()
        tool_id = f"toolu_read_{i}"
        emit({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [
            {"type": "tool_use", "id": tool_id, "name": "Read", "input": {"file_path": str(cwd / rel)}}]}, **base})
        emit({"type": "user", "parent_tool_use_id": None, "message": {"content": [
            {"type": "tool_result", "tool_use_id": tool_id, "content": "(file contents)"}]}, **base})

    hog = None
    if os.environ.get("FAKE_CLAUDE_ALLOC_MB"):
        hog = bytearray(int(os.environ["FAKE_CLAUDE_ALLOC_MB"]) * 1024 * 1024)
        for i in range(0, len(hog), 4096):  # touch every page so it is really resident
            hog[i] = 1
    crash = os.environ.get("FAKE_CLAUDE_CRASH")
    if crash == "kill":
        os.kill(os.getpid(), signal.SIGKILL)
    if crash == "oom":
        print("FATAL ERROR: JavaScript heap out of memory", file=sys.stderr, flush=True)
        return 134

    if os.environ.get("FAKE_CLAUDE_RATE_LIMIT"):
        emit({"type": "rate_limit_event", "rate_limit_info": {"status": "rejected", "resetsAt": int(time.time()) + 120}, **base})
        emit({"type": "result", "subtype": "success", "is_error": True, "num_turns": 1, "duration_ms": 900,
              "result": "Claude usage limit reached", "usage": {}, **base})
        return 1
    if os.environ.get("FAKE_CLAUDE_FAIL") == "auth":  # the shape Claude Code 2.1 emits without a login
        emit({"type": "assistant", "error": "authentication_failed", "parent_tool_use_id": None,
              "message": {"content": [{"type": "text", "text": "Not logged in · Please run /login"}]}, **base})
        emit({"type": "result", "subtype": "success", "is_error": True, "num_turns": 1, "duration_ms": 300,
              "result": "Not logged in · Please run /login", "usage": {}, **base})
        return 1
    if os.environ.get("FAKE_CLAUDE_FAIL"):
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "num_turns": 1,
              "duration_ms": 500, "errors": ["simulated failure"], "usage": {}, **base})
        return 1

    emit({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "utilization": 0.42}, **base})
    if not os.environ.get("FAKE_CLAUDE_SKIP_OUTPUTS"):
        for i, rel in enumerate(outputs):
            pause()
            path = cwd / rel
            path.parent.mkdir(parents=True, exist_ok=True)
            if rel in edited and path.is_file():
                content = path.read_text("utf-8").rstrip("\n") + "\n"
            else:
                content = sample_content(rel, title)
            if follow_up and rel.endswith(".md"):
                content += f"\n## ปรับตามข้อความล่าสุด\n- {follow_up.group(1).strip()}\n"
            path.write_text(content, encoding="utf-8")
            emit({"type": "assistant", "parent_tool_use_id": None, "message": {"content": [
                {"type": "tool_use", "id": f"toolu_write_{i}", "name": "Write", "input": {"file_path": str(path)}}]}, **base})
    pause()
    stream_text("เขียนไฟล์ผลลัพธ์ครบแล้ว ลองเปิดดูทางขวา แล้วพิมพ์บอกได้ถ้าอยากให้ปรับตรงไหน (โหมดสาธิต)", base, delay)
    emit({"type": "result", "subtype": "success", "is_error": False, "num_turns": 3 + len(inputs),
          "duration_ms": int(delay * 1000 * (4 + len(inputs) + len(outputs))),
          "result": "สร้างไฟล์ตัวอย่างเรียบร้อย (fake-claude ไม่ได้ใช้ Claude จริง)",
          "usage": {"input_tokens": 1200, "output_tokens": 350}, **base})
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
