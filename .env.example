# ===== ที่เก็บข้อมูลบน NAS (สร้างโฟลเดอร์ไว้ก่อน) =====
DATA_PATH=/volume1/ai-assistant/data
KNOWLEDGE_PATH=/volume1/ai-assistant/knowledge
CLAUDE_HOME_PATH=/volume1/ai-assistant/claude-home
PORT=8080

# ===== Claude (subscription) =====
# วิธีที่ 1 (แนะนำ): เว้นว่างไว้ แล้วล็อกอินใน container ด้วย
#   sudo docker exec -it ai-work-assistant claude auth login
# วิธีที่ 2: ใส่ token อายุ 1 ปีที่ได้จากคำสั่ง `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# เว้นว่าง = ใช้ model ตั้งต้นของแพ็กเกจ หรือระบุ alias เช่น opus / sonnet
CLAUDE_MODEL=
# เว้นว่าง = ค่าตั้งต้น หรือ low / medium / high / xhigh / max
CLAUDE_EFFORT=
# ทดลองระบบโดยไม่ใช้ Claude จริง: CLAUDE_BIN=/opt/app/scripts/fake-claude
CLAUDE_BIN=claude

# ===== การทำงาน =====
# ทำทีละงาน เพื่อไม่ให้ใช้โควต้า subscription หมดเร็ว
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_MIN=45
# สร้างงาน "ติดตามงาน" อัตโนมัติ (เว้นว่าง FOLLOWUP_TIME เพื่อปิด)
FOLLOWUP_TIME=08:00
FOLLOWUP_DAYS=mon,tue,wed,thu,fri
# ให้ Claude รัน python3 เพื่อคำนวณ (เฉพาะงานวิศวกรรมและใบเสนอราคา)
ALLOW_PYTHON=true

# ===== รหัสผ่านหน้า dashboard (แนะนำให้ตั้ง) =====
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
