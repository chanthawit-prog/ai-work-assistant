# ===== ที่เก็บข้อมูลบน NAS (สร้างโฟลเดอร์ไว้ก่อน) =====
DATA_PATH=/volume1/ai-assistant/data
KNOWLEDGE_PATH=/volume1/ai-assistant/knowledge
CLAUDE_HOME_PATH=/volume1/ai-assistant/claude-home
PORT=8080

# ===== Claude (subscription) =====
# วิธีที่ 1 (แนะนำ): เว้นว่างไว้ แล้วล็อกอินใน container ด้วย
#   sudo docker exec -it ai-work-assistant claude auth login
# วิธีที่ 2: ใส่ token อายุ 1 ปีที่ได้จากคำสั่ง `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# เว้นว่าง = ใช้ model ตั้งต้นของแพ็กเกจ หรือระบุ alias เช่น opus / sonnet
CLAUDE_MODEL=
# ระดับการคิดของทุกงาน low / medium / high / xhigh / max เว้นว่าง = ตามชนิดงาน (แนะนำ): งานเขียน medium,
# ติดตามงาน low, งานคำนวณและใบเสนอราคา high และเลือกต่องานได้ในหน้าเว็บ (ช่อง "Claude คิด")
CLAUDE_EFFORT=
# ทดลองระบบโดยไม่ใช้ Claude จริง: CLAUDE_BIN=/opt/app/scripts/fake-claude
CLAUDE_BIN=claude

# ===== การทำงาน =====
# ทำทีละงาน เพื่อไม่ให้ใช้โควต้า subscription หมดเร็ว และไม่ให้ RAM ของ NAS ตึง (เครื่อง RAM 6 GB ควรคงไว้ที่ 1)
MAX_CONCURRENT_JOBS=1
JOB_TIMEOUT_MIN=45
# สร้างงาน "ติดตามงาน" อัตโนมัติ (เว้นว่าง FOLLOWUP_TIME เพื่อปิด)
FOLLOWUP_TIME=08:00
FOLLOWUP_DAYS=mon,tue,wed,thu,fri
# ให้ Claude รัน python3 เพื่อคำนวณ (เฉพาะงานวิศวกรรมและใบเสนอราคา)
ALLOW_PYTHON=true

# ===== หน่วยความจำ (DS925+ RAM 6 GB ที่ swap เต็มง่าย) =====
# เพดาน RAM ของ container นี้ งานทั่วไปใช้ 200–300 MB ดูค่าจริงได้ที่หน้า "ระบบ" (ใช้ตอน Build เท่านั้น)
MEM_LIMIT=1536m
# เริ่มงานเมื่อ NAS มี RAM ว่างอย่างน้อยเท่านี้ (MB) ถ้าไม่พอ งานจะรอในคิวก่อน · 0 = ไม่ตรวจ
MIN_FREE_MEM_MB=700
# รอ RAM ว่างนานสุดกี่นาที ครบแล้วเริ่มงานเลย
MEM_WAIT_MAX_MIN=20
# ให้ Claude Code ใช้ RAM น้อยลง: BUN_OPTIONS=--smol, MALLOC_ARENA_MAX=2, ปิด telemetry, ไม่โหลด MCP server
CLAUDE_LOW_MEMORY=true
# ไฟล์แนบรวมต่อครั้ง (MB) ไฟล์ถูกเขียนลงดิสก์ทีละ 1 MB ไม่ค้างใน RAM
MAX_UPLOAD_MB=200

# ===== ค้นคลังความรู้ =====
# ทำดัชนีข้อความของ knowledge/ (PDF, Word, Markdown, CSV) และผลงานที่อนุมัติแล้ว ให้ Claude และหน้าเว็บค้นได้
# ทำเฉพาะตอนไม่มีงานและ RAM ว่างพอ ไฟล์ที่ไม่เปลี่ยนจะไม่อ่านซ้ำ
KB_SEARCH=true
# ตรวจหาไฟล์ใหม่หรือไฟล์ที่แก้ไขทุกกี่นาที
KB_REFRESH_MIN=30

# ===== ไฟล์ Word =====
# อนุมัติงานแล้วเก็บไฟล์ Word ไว้ใน library/ ข้างไฟล์ .md ด้วย (พร้อมส่งต่อ หรือ sync ผ่าน Synology Drive)
LIBRARY_DOCX=true
# ฝังฟอนต์ Anuphan ในไฟล์ (เพิ่มขนาดไฟล์ราว 140 KB) เครื่องที่ไม่มีฟอนต์ก็เปิดได้ถูกต้อง
DOCX_EMBED_FONTS=true

# ===== รหัสผ่านหน้า dashboard (แนะนำให้ตั้ง) =====
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# ที่อยู่ dashboard ที่เปิดจากมือถือ/คอม ใช้ทำลิงก์ในข้อความแจ้งเตือน เช่น http://192.168.1.20:8080
# ถ้าเปิดผ่าน Reverse Proxy ที่เปลี่ยนชื่อโฮสต์ ให้ใส่ที่อยู่จริงที่เปิด ระบบใช้ตรวจว่าคำขอมาจาก dashboard เอง ไม่ใช่เว็บอื่น
DASHBOARD_URL=

# ===== แจ้งเตือนเมื่องานรอตรวจหรือไม่สำเร็จ (ตั้งช่องทางไหนก็ได้ ไม่ตั้งก็ได้) =====
# Synology Chat: Chat > Integration > Incoming Webhooks > สร้างแล้วคัดลอก Webhook URL
NOTIFY_SYNOLOGY_CHAT_URL=
# LINE Messaging API (LINE Notify ปิดบริการแล้ว): channel access token และ user ID หรือ group ID ที่จะส่งถึง
NOTIFY_LINE_TOKEN=
NOTIFY_LINE_TO=
# ระบบอื่น เช่น Teams/Slack/n8n: รับ JSON {event, text, job{id,title,url}}
NOTIFY_WEBHOOK_URL=
# เหตุการณ์ที่แจ้ง: needs_review, failed, quota_wait
NOTIFY_ON=needs_review,failed
# สรุปงานตอนเช้า (ไม่ใช้ Claude ไม่เสียโควต้า): รายการติดตามที่เลยกำหนด/ครบกำหนดวันนี้ งานรอตรวจ และงานประจำของวัน
# ส่งทางช่องทางแจ้งเตือนข้างบน ในวันตาม FOLLOWUP_DAYS เฉพาะวันที่มีเรื่องให้ดู เว้นว่าง = ปิด เช่น 07:30
DIGEST_TIME=

# ===== ส่งอีเมลจาก dashboard (ไม่บังคับ) =====
# ส่งผลงานที่อนุมัติแล้ว (เช่น ใบเสนอราคาเป็นไฟล์ Word) ถึงลูกค้าจากหน้างาน ด้วยบัญชีอีเมลของบริษัท
# ระบบไม่ส่งอะไรเอง ส่งเฉพาะฉบับที่คุณกดยืนยันในฟอร์ม และรหัสผ่านนี้ไม่ถูกส่งต่อให้ Claude
# Gmail / Google Workspace: smtp.gmail.com 587 starttls ใช้ App password (ต้องเปิด 2-Step Verification ก่อน)
# Microsoft 365: smtp.office365.com 587 starttls (ผู้ดูแลต้องเปิด "Authenticated SMTP" ให้บัญชีนั้น)
# เซิร์ฟเวอร์ในออฟฟิศที่ไม่เข้ารหัส: MAIL_SMTP_SECURITY=none (ใช้ใน LAN เท่านั้น)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
# starttls / ssl (port 465) / none
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# ที่อยู่ผู้ส่ง (Gmail และ Microsoft 365 ต้องเป็นบัญชีที่ล็อกอินหรือ alias ที่ยืนยันแล้ว) และชื่อที่แสดง
MAIL_FROM=
MAIL_FROM_NAME=
# เก็บสำเนาทุกฉบับที่ส่ง เช่น กล่องจดหมายกลางของฝ่ายขาย เว้นว่าง = ไม่เก็บ
MAIL_BCC=

# ===== อ่าน PDF ที่เป็นภาพสแกน (OCR) =====
# PDF ที่สแกนมา (ใบเสนอราคาเก่า แบบ สเปกจากผู้ขาย) ไม่มีข้อความให้ค้น ระบบอ่านด้วย tesseract ภาษาไทย+อังกฤษ (ติดตั้งใน image แล้ว)
# ทั้งไฟล์ในคลังความรู้ (ตอนทำดัชนี เมื่อไม่มีงาน) และไฟล์ที่แนบกับงาน (ได้ไฟล์ "<ชื่อ>.ocr.txt" ให้ Claude อ่านแทนภาพ)
# อ่านทีละหน้า 2 เธรด RAM ราว 150 MB หน้าละประมาณ 5–10 วินาทีบน DS925+ ผลเก็บไว้ ไฟล์เดิมไม่อ่านซ้ำ
OCR=true
# ภาษาของ tesseract (ใน image มี tha และ eng)
OCR_LANGS=tha+eng
# จำนวนหน้าภาพต่อไฟล์ที่อ่าน เกินนั้นข้าม (หน้าระบบและหน้างานจะบอก)
OCR_MAX_PAGES=40
